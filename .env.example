# Copy this file to .env.local and replace all three example values.
# Full walkthrough and copy/paste template: docs/emailjs-setup.md
# EmailJS dashboard > Email Services > your existing Gmail service > Service ID
VITE_EMAILJS_SERVICE_ID=service_your_service_id
# EmailJS dashboard > Email Templates > your saved template > Settings > Template ID
VITE_EMAILJS_TEMPLATE_ID=template_contact_notification
# EmailJS dashboard > Account > API Keys > Public Key (never use a private key)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Restart npm run dev after changes. For hosting, set these variables and rebuild.
